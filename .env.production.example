# Copy this to .env on the EC2 instance (same directory as docker-compose.yml)
# and fill in real values. Never commit the real .env file.

DB_NAME=pathforge
DB_USERNAME=postgres
# Generate with: openssl rand -base64 24
DB_PASSWORD=

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Your EC2 public IP or domain, e.g. http://12.34.56.78 or https://pathforge.example.com
FRONTEND_URL=

# Optional — leave blank to log password-reset links to the console instead of
# emailing them (check with: docker compose logs backend).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Set both to create the initial admin account on first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
