DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=pathforge
DB_PORT=5432
JWT_SECRET=change-this-to-a-long-random-secret-key

# Optional — leave blank to log password-reset links to the console instead
# of emailing them. Fill these in with real SMTP credentials (Gmail app
# password, SendGrid/Mailgun/Resend SMTP relay, etc.) to send real emails.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173

# Set these to have the backend create a single ADMIN account on first
# startup (skipped if an admin already exists, or if either is left blank).
# This is the only way to get an admin account — /register refuses to
# create one. Needed to verify companies, moderate reports, etc.
ADMIN_EMAIL=
ADMIN_PASSWORD=
